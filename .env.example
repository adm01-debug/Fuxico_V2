# FUXICO Environment Variables
# Copy this file to .env and fill in your values

# Supabase
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# =============================================================================
# 🔒 SECURITY - IP WHITELIST
# =============================================================================
# Comma-separated list of trusted IP addresses
# These IPs will have access to protected Edge Functions
#
# Examples:
# - Single IP: 203.0.113.50
# - Multiple IPs: 203.0.113.50,198.51.100.25,192.0.2.100
# - CIDR Range: 10.0.0.0/8 (use with caution)
#
# How to find your IP:
# - Run: curl ifconfig.me
# - Or visit: https://whatismyipaddress.com
#
WHITELISTED_IPS=127.0.0.1,::1

# =============================================================================
# Add your IPs below (remove comments and add your actual IPs):
# =============================================================================
# OFFICE_IP=203.0.113.50
# VPN_IP=198.51.100.25
# HOME_IP=192.0.2.100
# CI_CD_IP=185.199.108.0/22

# =============================================================================
# Rate Limiting (optional)
# =============================================================================
# RATE_LIMIT_WINDOW_MS=60000
# RATE_LIMIT_MAX_REQUESTS=100

# =============================================================================
# Other Settings
# =============================================================================
# BITRIX24_WEBHOOK_URL=https://your-domain.bitrix24.com/rest/1/xxxxx/
# RESEND_API_KEY=re_xxxxx

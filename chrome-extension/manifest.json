{
  "manifest_version": 3,
  "name": "FUXICO - Email Tracker",
  "short_name": "FUXICO",
  "version": "1.1.0",
  "description": "Saiba quando seus emails são lidos. Rastreamento de aberturas e cliques para Gmail com autenticação segura.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "notifications",
    "activeTab",
    "alarms"
  ],
  "host_permissions": [
    "https://mail.google.com/*",
    "https://*.supabase.co/*"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "FUXICO - Email Tracker"
  },
  "content_scripts": [
    {
      "matches": ["https://mail.google.com/*"],
      "js": ["content/gmail.js"],
      "css": ["styles/gmail-inject.css"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "web_accessible_resources": [
    {
      "resources": ["icons/*", "config.js"],
      "matches": ["https://mail.google.com/*"]
    }
  ]
}

{
  "tasks": {
    "test": "deno test --allow-env --allow-net --allow-read _shared/*.test.ts _tests/*.test.ts",
    "test:watch": "deno test --allow-env --allow-net --allow-read --watch _shared/*.test.ts _tests/*.test.ts",
    "test:coverage": "deno test --allow-env --allow-net --allow-read --coverage=coverage _shared/*.test.ts _tests/*.test.ts",
    "coverage:report": "deno coverage coverage --lcov > coverage/lcov.info"
  },
  "imports": {
    "@std/assert": "https://deno.land/std@0.208.0/assert/mod.ts"
  },
  "compilerOptions": {
    "strict": true
  }
}
